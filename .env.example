# Copy to .env.local for local use, or set these in your hosting dashboard.

# Port the server listens on (hosts such as Render set this automatically)
PORT=3000

# Passwords for the three built-in users, read once when the database is first created.
# If not set, demo passwords are used (see README) - do not use those with real data.
ADMIN_PASSWORD=
MAKER_PASSWORD=
CHECKER_PASSWORD=

# Set to true to load fictional employees and six months of payroll into an empty database (for demos)
SEED_DEMO=false

# Google Gemini key for AI commentary and payslip explanations (optional; from aistudio.google.com)
GEMINI_API_KEY=
# Model name (optional)
GEMINI_MODEL=gemini-2.5-flash

# Folder for the SQLite database (optional; default ./data). Point this at a persistent disk when hosting.
DATA_DIR=
